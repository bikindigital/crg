---
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';
---

<header class="hdr" data-hdr>
  <div class="container bar">
    <a href="#top" class="logo" aria-label="CRG, ka luhur">
      <LogoMark size={34} />
      <span class="word">crg<b>.web.id</b></span>
    </a>

    <nav class="nav" aria-label="Navigasi utama (desktop)">
      <ul role="list">
        <li><a href="#top" data-nav="top">Beranda</a></li>
        <li><a href="#playground" data-nav="playground">Playground</a></li>
        <li><a href="#kamus" data-nav="kamus">Kamus</a></li>
      </ul>
    </nav>

    <div class="tools">
      <button class="icon-btn theme-toggle" type="button" aria-label="Ganti mode tema" aria-pressed="false">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn-primary cta" href="#playground">
        <Icon name="play" size={16} />
        Coba Ayeuna
      </a>
    </div>
  </div>
</header>

<!-- Navigasi bawah ala aplikasi (HP), bar melayang berbentuk pill -->
<nav class="bnav" aria-label="Navigasi utama">
  <ul role="list">
    <li><a href="#top" data-nav="top"><Icon name="home" size={22} /><span>Beranda</span></a></li>
    <li><a href="#playground" data-nav="playground"><Icon name="terminal" size={22} /><span>Playground</span></a></li>
    <li><a href="#kamus" data-nav="kamus"><Icon name="book" size={22} /><span>Kamus</span></a></li>
  </ul>
</nav>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--canvas) 86%, transparent);
    backdrop-filter: blur(12px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease-out;
  }
  .hdr.scrolled { border-bottom-color: var(--line); }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: 72px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    min-height: 44px;
    color: var(--text);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .word b { color: var(--link); font-weight: 700; }

  .nav ul {
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: 9999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 9999px;
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 500;
    transition: color 0.18s ease, background-color 0.18s ease;
  }
  .nav a:hover { color: var(--text); background: var(--sunken); }
  .nav a[aria-current='true'] { color: #fff; background: var(--brand); }

  .tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: var(--text-2);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: box-shadow 0.18s ease, color 0.18s ease;
  }
  .icon-btn:hover { color: var(--text); box-shadow: inset 0 0 0 1px var(--text); }
  .theme-toggle :global(.i-sun) { display: none; }
  :global([data-theme='dark']) .theme-toggle :global(.i-sun) { display: block; }
  :global([data-theme='dark']) .theme-toggle :global(.i-moon) { display: none; }

  .cta { min-height: 44px; padding: 0 18px; font-size: 14.5px; }

  /* ===== Nav bawah (HP) ===== */
  .bnav { display: none; }

  @media (max-width: 900px) {
    .bar { grid-template-columns: 1fr auto; height: 64px; }
    .nav { display: none; }
    .cta { display: none; }

    .bnav {
      display: block;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 60;
      max-width: 440px;
      margin-inline: auto;
      padding: 6px;
      border: 1px solid var(--line);
      border-radius: 9999px;
      background: color-mix(in srgb, var(--surface) 90%, transparent);
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(14px) saturate(1.3);
    }
    .bnav ul {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
    }
    .bnav a {
      display: grid;
      place-items: center;
      align-content: center;
      gap: 2px;
      min-height: 56px;
      border-radius: 9999px;
      color: var(--muted);
      font-size: 11.5px;
      font-weight: 500;
      transition: color 0.18s ease, background-color 0.18s ease;
    }
    .bnav a[aria-current='true'] { color: var(--link); background: var(--brand-soft); }
  }
</style>

<script>
  // ===== Tema =====
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const meta = document.querySelector('meta[name="theme-color"]');

  function syncToggle() {
    const dark = root.getAttribute('data-theme') === 'dark';
    toggle?.setAttribute('aria-pressed', String(dark));
    toggle?.setAttribute('aria-label', dark ? 'Ganti ka mode caang' : 'Ganti ka mode poek');
    meta?.setAttribute('content', dark ? '#0b1513' : '#f7f8f5');
  }

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('crg-theme', next); } catch {}
    syncToggle();
  });
  syncToggle();

  // ===== Garis header saat digulir & menu aktif =====
  const hdr = document.querySelector('[data-hdr]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const ids = ['playground', 'kamus'];

  function update() {
    hdr?.classList.toggle('scrolled', window.scrollY > 8);
    let current = 'top';
    for (const id of ids) {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 160) current = id;
    }
    links.forEach((a) => {
      if (a.dataset.nav === current) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
