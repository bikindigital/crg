---
import Icon from './Icon.astro';
import { categories, totalAktif, totalRencana } from '../data/kamus.js';
---

<div class="tools">
  <div class="search">
    <Icon name="search" size={18} />
    <label for="kamus-q" class="visually-hidden">Teangan kecap konci</label>
    <input id="kamus-q" type="search" placeholder="Teangan: wadah, loop, if, class…" autocomplete="off" />
  </div>
  <div class="legend">
    <span class="pill on">Aktif · {totalAktif}</span>
    <span class="pill plan">Rencana · {totalRencana}</span>
  </div>
</div>
<p class="empty" id="kamus-empty" hidden>Teu kapanggih. Coba kecap sejen, atawa padananana (conto: "if", "loop").</p>

<div class="grid" id="kamus-grid">
  {
    categories.map((cat) => (
      <section class="cat" aria-label={cat.name} data-cat>
        <h3>{cat.name}</h3>
        <ul role="list">
          {cat.keywords.map((k) => (
            <li
              class:list={['kw', { planned: !k.aktif }]}
              data-search={`${k.s} ${k.e} ${k.d}`.toLowerCase()}
            >
              <div class="kw-top">
                <code class="crg">{k.s}</code>
                <span class="eq">{k.e}</span>
                <span class:list={['status', k.aktif ? 'on' : 'plan']}>{k.aktif ? 'Aktif' : 'Rencana'}</span>
              </div>
              <p>{k.d}</p>
              {k.c && (
                <div class="example">
                  <div class="ex-bar">
                    <span>Conto</span>
                    <button type="button" class="try" data-code={k.c} aria-label={`Coba conto ${k.s} di Playground`}>
                      <Icon name="play" size={13} />
                      Coba
                    </button>
                  </div>
                  <pre>{k.c}</pre>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<script>
  // "Coba": kirim conto ka Playground
  document.querySelectorAll<HTMLButtonElement>('.try[data-code]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('crg:coba', { detail: btn.dataset.code }));
    });
  });

  // Teangan
  const q = document.getElementById('kamus-q') as HTMLInputElement | null;
  const empty = document.getElementById('kamus-empty');
  const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
  q?.addEventListener('input', () => {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const cat of cats) {
      let catShown = 0;
      cat.querySelectorAll<HTMLElement>('[data-search]').forEach((li) => {
        const hit = !term || (li.dataset.search ?? '').includes(term);
        li.hidden = !hit;
        if (hit) catShown++;
      });
      cat.hidden = catShown === 0;
      shown += catShown;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    margin-bottom: 24px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 320px;
    max-width: 440px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 9999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--muted);
    transition: box-shadow 0.18s ease;
  }
  .search:focus-within { box-shadow: inset 0 0 0 1.5px var(--brand); }
  .search input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }
  .search input::placeholder { color: var(--muted); }
  .legend { display: flex; gap: 8px; }
  .pill,
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .pill::before,
  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .on { color: var(--link); background: var(--brand-soft); }
  .plan { color: var(--muted); background: var(--sunken); box-shadow: inset 0 0 0 1px var(--line); }
  .empty { margin-bottom: 24px; color: var(--muted); }

  .grid {
    columns: 3 340px;
    column-gap: 16px;
  }
  .cat {
    break-inside: avoid;
    margin-bottom: 16px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .cat[hidden], .kw[hidden] { display: none; }
  h3 {
    margin-bottom: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0;
    list-style: none;
  }
  .kw {
    padding: 12px 10px;
    border-radius: var(--radius-sm);
  }
  .kw + .kw { border-top: 1px dashed var(--line); border-radius: 0; }
  .kw-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .crg { font-size: 0.95rem; font-weight: 600; padding: 2px 8px; }
  .planned .crg { color: var(--text-2); background: var(--sunken); }
  .eq {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .status { margin-left: auto; padding: 2px 10px; font-size: 11px; }
  .kw p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .example {
    margin-top: 10px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--code-bg);
  }
  .ex-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 6px 6px 14px;
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
    color: var(--code-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .example pre {
    margin: 0;
    padding: 12px 14px;
    overflow-x: auto;
    color: var(--code-text);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .try {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px;
    border-radius: 9999px;
    background: var(--gold);
    color: var(--on-gold);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-sans);
    transition: filter 0.18s ease;
  }
  .try:hover { filter: brightness(1.05); }
  .try::after {
    /* area sentuh minimal 44px tanpa ngagedekeun tombol */
    content: '';
    position: absolute;
    inset: -6px;
  }
</style>
