---
/** Tanda logo CRG: kotak teal, garis emas di bawah, kurung kurawal putih. Sama persis dengan favicon.svg. */
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
const id = `lm-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={id}><rect width="64" height="64" rx="16"></rect></clipPath>
  </defs>
  <g clip-path={`url(#${id})`}>
    <rect width="64" height="64" fill="#087F73"></rect>
    <rect y="57" width="64" height="7" fill="#FFC52E"></rect>
  </g>
  <g fill="none" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M26 15c-4.5 0-6.5 2-6.5 5.5v4.5c0 3-1.5 4.5-4.5 4.5 3 0 4.5 1.5 4.5 4.5v4.5c0 3.5 2 5.5 6.5 5.5"></path>
    <path d="M38 15c4.5 0 6.5 2 6.5 5.5v4.5c0 3 1.5 4.5 4.5 4.5-3 0-4.5 1.5-4.5 4.5v4.5c0 3.5-2 5.5-6.5 5.5"></path>
  </g>
</svg>
