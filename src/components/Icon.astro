---
/**
 * Set ikon garis 24x24, stroke 1.6, sudut bulat — satu gaya dengan bikindigital.id.
 * Tanpa label = dekoratif (aria-hidden).
 */
const icons = {
  home: 'M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1Z',
  terminal: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM7.5 9.5l3 2.5-3 2.5M12.5 15H17',
  book: 'M5 5.5A2.5 2.5 0 0 1 7.5 3H19v13.5H7.5A2.5 2.5 0 0 0 5 19ZM5 19a2.5 2.5 0 0 0 2.5 2.5H19v-5M9 7.5h6',
  play: 'M8 5.5v13l10.5-6.5Z',
  copy: 'M9 9h11v11H9ZM5 15H4V4h11v1',
  share: 'M12 15V4M7.5 8.5 12 4l4.5 4.5M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6',
  trash: 'M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3',
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
  moon: 'M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z',
  chevron: 'm6 9 6 6 6-6',
  check: 'M5 12.5 10 17l9-10',
  code: 'm8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14',
  tree: 'M5 4h5v5H5ZM14 15h5v5h-5ZM14 9.5h5v5h-5ZM7.5 9v8.5H14M7.5 12H14',
  globe: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM3 12h18M12 3c2.4 2.5 3.5 5.5 3.5 9s-1.1 6.5-3.5 9c-2.4-2.5-3.5-5.5-3.5-9S9.6 5.5 12 3Z',
  bolt: 'M13 3 5 13.5h6L10 21l8-10.5h-6Z',
  leaf: 'M5 19c0-8 5-14 15-14 0 10-6 15-14 15M5 19l7-7',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  caret: 'm9 6 6 6-6 6',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14ZM20 20l-4-4',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"><path d={icons[name]}></path></svg>
