---
import Layout from '../layouts/Layout.astro';
import Playground from '../components/Playground.astro';
import Kamus from '../components/Kamus.astro';
import Navbar from '../components/Navbar.astro';
import Icon from '../components/Icon.astro';
import LogoMark from '../components/LogoMark.astro';
import { totalAktif } from '../data/kamus';

const year = new Date().getFullYear();
---

<Layout title="CRG — Curug Language">
	<Navbar />
	<main id="top">
		<!-- Hero -->
		<section class="hero container" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Beta · v1.0.0</p>
				<h1 id="hero-title">Basa coding<br /><span class="accent">Curug Language.</span></h1>
				<p class="lead">
					<strong>CRG</strong> nyaeta basa coding gaya santai khas Sunda Tangerang — gampang kaharti jeung enteng
					dipake. Tulis kode ku kecap sapopoe, jalankeun langsung di browser.
				</p>

				<div class="actions">
					<a href="#playground" class="btn btn-primary">
						<Icon name="terminal" />
						Coba Ayeuna
					</a>
					<a href="#kamus" class="btn btn-ghost">
						<Icon name="book" />
						Buka Kamus
					</a>
				</div>

				<dl class="facts">
					<div>
						<dt>Kecap konci aktif</dt>
						<dd>{totalAktif}</dd>
					</div>
					<div>
						<dt>Parser</dt>
						<dd>Pratt · AST</dd>
					</div>
					<div>
						<dt>Install</dt>
						<dd>Teu perlu</dd>
					</div>
				</dl>
			</div>

			<figure class="code-window" aria-label="Conto kode CRG jeung hasilna">
				<div class="window-bar">
					<span class="file"><Icon name="code" size={15} /> halo_curug.crg</span>
					<span class="lang">CRG</span>
				</div>
				<pre class="hero-code"><span class="c-comment"># Halo Barudak Curug!</span>
<span class="c-kw">wadah</span> ngaran = <span class="c-str">"Asep"</span>
<span class="c-kw">wadah</span> umur = <span class="c-num">17</span>

<span class="c-fn">ngomong</span>(<span class="c-str">"Sampurasun, "</span> + ngaran)

<span class="c-kw">mun</span> umur &gt; <span class="c-num">17</span> &lbrace;
  <span class="c-fn">ngomong</span>(<span class="c-str">"Geus kolot!"</span>) <span class="c-jasa">jasa</span>
&rbrace; <span class="c-kw">munteu</span> &lbrace;
  <span class="c-fn">ngomong</span>(<span class="c-str">"Masih budak"</span>)
&rbrace; <span class="c-atuh">atuh</span></pre>
				<figcaption class="window-output">
					<span class="out-label">Hasil</span>
					<span><span class="prompt" aria-hidden="true">❯</span> Sampurasun, Asep</span>
					<span><span class="prompt" aria-hidden="true">❯</span> Masih budak</span>
				</figcaption>
			</figure>
		</section>

		<!-- Fitur -->
		<section class="features container" aria-labelledby="fitur-title">
			<div class="section-head">
				<p class="eyebrow">Naon CRG teh</p>
				<h2 id="fitur-title">Logika coding, ku basa urang sorangan.</h2>
			</div>
			<ul class="bento" role="list">
				<li class="card wide">
					<span class="ic"><Icon name="code" size={22} /></span>
					<h3>Sintaks sederhana &amp; ekspresif</h3>
					<p>
						Tulis kode pake kecap sapopoe ala Curug. <code>wadah</code> keur variabel, <code>mun/munteu</code>
						keur kondisi, <code>keur</code> keur looping. Diajar logika tanpa pusing hafalan sintaks asing.
					</p>
				</li>
				<li class="card">
					<span class="ic"><Icon name="tree" size={22} /></span>
					<h3>AST parser</h3>
					<p>Diwangun ku <strong>Pratt parser</strong> berbasis AST — mesin nyata, lain ukur string matching.</p>
				</li>
				<li class="card">
					<span class="ic"><Icon name="globe" size={22} /></span>
					<h3>Langsung di browser</h3>
					<p>Ngoding tanpa install. Jalan mulus di laptop atawa HP.</p>
				</li>
				<li class="card">
					<span class="ic gold"><Icon name="bolt" size={22} /></span>
					<h3>Postfix <code>jasa</code></h3>
					<p>Tambahkeun <code>jasa</code> di tukang statement: teks meunang "Jasa!", angka dikali 100.</p>
				</li>
				<li class="card tall">
					<span class="ic"><Icon name="leaf" size={22} /></span>
					<h3>Kearifan lokal</h3>
					<p>Terinspirasi dialek asli Curug, Tangerang. Unggal kecap konci akrab keur warga Sunda Tangerang.</p>
					<ul class="tags" role="list">
						{['wadah', 'ngomong', 'mun', 'munteu', 'keur', 'unggal', 'lakon', 'imah', 'cobaan', 'jasa', 'atuh'].map((t) => <li>{t}</li>)}
					</ul>
				</li>
			</ul>
		</section>

		<!-- Playground -->
		<section id="playground" class="section container" aria-labelledby="pg-title">
			<div class="section-head">
				<p class="eyebrow">Playground</p>
				<h2 id="pg-title">Ngoding langsung, hasilna kaluar saharita.</h2>
				<p class="sub">Pencet <kbd>Ctrl</kbd> + <kbd>Enter</kbd> pikeun ngajalankeun kode.</p>
			</div>
			<Playground />
		</section>

		<!-- Kamus -->
		<section id="kamus" class="section container" aria-labelledby="kamus-title">
			<div class="section-head">
				<p class="eyebrow">Kamus</p>
				<h2 id="kamus-title">Sadaya kecap konci CRG.</h2>
				<p class="sub">
					Unggal kecap aya padanan sintaks modern jeung conto nu bisa langsung dicoba. Label <em>Rencana</em> hartina
					can dirojong ku interpreter.
				</p>
			</div>
			<Kamus />
		</section>
	</main>

	<footer class="foot">
		<div class="container foot-inner">
			<a href="#top" class="foot-logo"><LogoMark size={30} /><span>crg<b>.web.id</b></span></a>
			<p>Curug Language — basa coding gaya santai khas Sunda Tangerang.</p>
			<p class="muted">
				© {year} <a class="credit" href="https://bikindigital.id" rel="author">BikinDigital</a> · Gampang kaharti,
				enteng dipake.
			</p>
		</div>
	</footer>
</Layout>

<style>
	/* ===== HERO ===== */
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 56px;
		align-items: center;
		padding-block: clamp(48px, 8vw, 104px) clamp(56px, 8vw, 96px);
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
		background-size: 120px 100%;
		background-position: center top;
		mask-image: linear-gradient(to bottom, #000, transparent);
		opacity: 0.55;
		pointer-events: none;
	}
	h1 {
		margin: 24px 0 24px;
		font-size: clamp(2.75rem, 6.2vw, 5.25rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.05em;
	}
	.accent { color: var(--link); }
	.lead {
		max-width: 48ch;
		color: var(--muted);
		font-size: clamp(1.0625rem, 1.5vw, 1.2rem);
		line-height: 1.55;
	}
	.lead strong { color: var(--text); font-weight: 600; }
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 32px;
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}
	.facts div { display: flex; flex-direction: column-reverse; gap: 2px; }
	.facts dt {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.02em;
		color: var(--muted);
	}
	.facts dd {
		margin: 0;
		color: var(--text);
		font-size: 1.35rem;
		font-weight: 650;
		letter-spacing: -0.03em;
	}

	/* ===== CODE WINDOW (selalu gelap) ===== */
	.code-window {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--code-bg);
		box-shadow: var(--shadow-lg), 0 0 0 1px rgb(255 255 255 / 0.04) inset;
	}
	.window-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 14px 20px;
		background: var(--code-bar);
		border-bottom: 1px solid var(--code-line);
	}
	.file {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--code-muted);
		font-family: var(--font-mono);
		font-size: 13px;
	}
	.lang {
		padding: 3px 10px;
		border-radius: 9999px;
		background: rgb(var(--gold-rgb) / 0.16);
		color: var(--gold);
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
	}
	.hero-code {
		margin: 0;
		padding: 22px 24px;
		overflow-x: auto;
		color: var(--code-text);
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.8;
		white-space: pre;
	}
	.window-output {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 14px 24px 18px;
		border-top: 1px solid var(--code-line);
		background: var(--code-bar);
		color: #b8e6a6;
		font-family: var(--font-mono);
		font-size: 13.5px;
	}
	.out-label {
		margin-bottom: 4px;
		color: var(--code-muted);
		font-size: 11.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.prompt { color: var(--gold); }

	/* ===== SECTION HEAD ===== */
	.section-head { max-width: 760px; margin-bottom: 40px; }
	.section-head h2 {
		margin-top: 18px;
		font-size: clamp(2rem, 4.2vw, 3.25rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.045em;
	}
	.sub {
		margin-top: 16px;
		max-width: 56ch;
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.sub em { font-style: normal; color: var(--text); font-weight: 550; }
	kbd {
		display: inline-block;
		padding: 1px 8px;
		border-radius: 6px;
		background: var(--surface);
		box-shadow: inset 0 0 0 1px var(--line-2), 0 1px 0 var(--line-2);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.82em;
	}

	/* ===== FITUR (bento) ===== */
	.features { padding-block: clamp(56px, 8vw, 104px); }
	.bento {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		padding: 0;
		list-style: none;
	}
	.card {
		padding: 28px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
	}
	.card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
	.wide { grid-column: span 2; }
	.tall { grid-row: span 2; }
	.ic {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		margin-bottom: 20px;
		border-radius: 14px;
		color: var(--link);
		background: var(--brand-soft);
	}
	.ic.gold { color: #9a6a00; background: rgb(var(--gold-rgb) / 0.2); }
	:global([data-theme='dark']) .ic.gold { color: var(--gold); }
	.card h3 { font-size: 1.15rem; font-weight: 650; letter-spacing: -0.025em; margin-bottom: 8px; }
	.card p { color: var(--muted); font-size: 0.95rem; line-height: 1.6; }
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 22px;
		padding: 0;
		list-style: none;
	}
	.tags li {
		padding: 4px 12px;
		border-radius: 9999px;
		background: var(--sunken);
		box-shadow: inset 0 0 0 1px var(--line);
		color: var(--text-2);
		font-family: var(--font-mono);
		font-size: 13px;
	}

	.section { padding-block: clamp(56px, 8vw, 104px); }

	/* ===== FOOTER ===== */
	.foot {
		margin-top: 40px;
		padding-block: 40px 48px;
		border-top: 1px solid var(--line);
	}
	.foot-inner { display: flex; flex-direction: column; gap: 6px; }
	.foot-logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		width: fit-content;
		margin-bottom: 8px;
		color: var(--text);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.foot-logo b { color: var(--link); }
	.foot p { color: var(--text-2); font-size: 0.95rem; }
	.foot .muted { color: var(--muted); font-size: 0.85rem; }
	.credit {
		color: var(--link);
		font-weight: 550;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.credit:hover { text-decoration-thickness: 2px; }

	/* ===== RESPONSIVE ===== */
	@media (max-width: 960px) {
		.hero { grid-template-columns: 1fr; gap: 40px; }
		.bento { grid-template-columns: 1fr 1fr; }
		.tall { grid-row: auto; }
	}
	@media (max-width: 900px) {
		.foot { padding-bottom: 120px; }
	}
	@media (max-width: 640px) {
		.bento { grid-template-columns: 1fr; }
		.wide { grid-column: auto; }
		.actions .btn { flex: 1 1 auto; }
		.hero-code { font-size: 13px; padding: 18px; }
		.window-output { padding-inline: 18px; }
	}
</style>
