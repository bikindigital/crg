---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Kaca teu kapanggih — CRG"
  description="Kaca nu dipilarian teu aya di crg.web.id."
  noindex
>
  <Navbar />
  <main id="top" class="nf container">
    <div class="copy">
      <p class="eyebrow">Kasalahan 404</p>
      <h1>Kaca ieu <span>acan</span> aya.</h1>
      <p class="lead">
        Bisa jadi link-na salah ketik, atawa kacana geus dipindahkeun. Hayu balik deui ka beranda, atawa langsung
        ngoding di Playground.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/">
          <Icon name="home" />
          Ka Beranda
        </a>
        <a class="btn btn-ghost" href="/#playground">
          <Icon name="terminal" />
          Buka Playground
        </a>
      </div>
    </div>

    <figure class="code" aria-label="Conto kode CRG: kaca nu teu kapanggih">
      <div class="bar"><span>kaca.crg</span><span class="tag">404</span></div>
      <pre><span class="c-kw">wadah</span> kaca = <span class="c-kw">acan</span>

<span class="c-kw">mun</span> kaca == <span class="c-kw">acan</span> &lbrace;
  <span class="c-fn">ngomong</span>(<span class="c-str">"Kaca teu kapanggih"</span>) <span class="c-jasa">jasa</span>
  <span class="c-kw">balik</span> <span class="c-str">"/"</span>
&rbrace;</pre>
      <figcaption class="out"><span class="prompt" aria-hidden="true">❯</span> Kaca teu kapanggih Jasa!</figcaption>
    </figure>
  </main>
</Layout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
    min-height: calc(100svh - 72px);
    padding-block: 48px 96px;
  }
  .nf::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: 120px 100%;
    mask-image: linear-gradient(to bottom, #000, transparent);
    opacity: 0.55;
    pointer-events: none;
  }
  h1 {
    margin: 22px 0;
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  h1 span { color: var(--link); }
  .lead {
    max-width: 46ch;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.5vw, 1.2rem);
    line-height: 1.55;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .code {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--code-bg);
    box-shadow: var(--shadow-lg);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
    color: var(--code-muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .tag {
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgb(var(--gold-rgb) / 0.16);
    color: var(--gold);
    font-size: 11.5px;
    font-weight: 600;
  }
  pre {
    margin: 0;
    padding: 22px 24px;
    overflow-x: auto;
    color: var(--code-text);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.8;
  }
  .out {
    padding: 14px 24px 18px;
    border-top: 1px solid var(--code-line);
    background: var(--code-bar);
    color: #b8e6a6;
    font-family: var(--font-mono);
    font-size: 13.5px;
  }
  .prompt { color: var(--gold); }

  @media (max-width: 900px) {
    .nf { grid-template-columns: 1fr; gap: 40px; min-height: 0; padding-bottom: 140px; }
  }
  @media (max-width: 640px) {
    .actions .btn { flex: 1 1 auto; }
    pre { font-size: 13px; padding: 18px; }
  }
</style>
